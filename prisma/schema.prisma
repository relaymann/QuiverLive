datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

model User {
  id             String  @id @default(uuid())
  username       String  @unique
  imageUrl       String  @db.Text
  externalUserId String  @unique
  bio            String? @db.Text
  following  Follow[] @relation("Following")
  followedBy Follow[] @relation("FollowedBy")
  blocking   Block[]  @relation("Blocking")
  blockedBy  Block[]  @relation("BlockedBy")
  stream         Stream?
  chatRateLimits ChatRateLimit[]
  moderatedInChannels ChatModeration[] @relation("ModeratedParticipant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stream {
  id           String  @id @default(uuid())
  name         String  @db.Text
  thumbnailUrl String? @db.Text
  ingressId    String? @unique
  serverUrl    String? @db.Text
  streamKey    String? @db.Text
  isLive              Boolean @default(false)
  isChatEnabled       Boolean @default(true)
  isChatDelayed       Boolean @default(false)
  isChatFollowersOnly Boolean @default(false)
  broadcastSource     String? @db.VarChar(16)
  broadcastSessionId String? @db.VarChar(64)
  broadcastLeaseExpiresAt DateTime?
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRateLimits ChatRateLimit[]
  guestChatRateLimits GuestChatRateLimit[]
  chatModerations ChatModeration[]
  watchSessions WatchSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([ingressId])
  @@index([broadcastSessionId])
  @@fulltext([name])
}

model ChatRateLimit {
  id            String   @id @default(uuid())
  streamId      String
  senderId      String
  nextAllowedAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@unique([streamId, senderId])
  @@index([nextAllowedAt])
}

model GuestChatRateLimit {
  id            String   @id @default(uuid())
  streamId      String
  senderIdentity String @db.VarChar(128)
  nextAllowedAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([streamId, senderIdentity])
  @@index([nextAllowedAt])
}

model ChatModeration {
  id                  String   @id @default(uuid())
  streamId            String
  participantIdentity String   @db.VarChar(128)
  participantUserId   String?
  isBanned            Boolean  @default(false)
  timedOutUntil       DateTime?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  participantUser User? @relation("ModeratedParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([streamId, participantIdentity])
  @@index([streamId, isBanned])
  @@index([timedOutUntil])
}

model WatchSession {
  id                  String   @id @default(uuid())
  streamId            String
  participantSid      String   @db.VarChar(128)
  participantIdentity String   @db.VarChar(128)
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([streamId, participantSid])
  @@index([streamId, participantIdentity, endedAt])
  @@index([startedAt])
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String
  follower  User @relation(name: "Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation(name: "FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String @id @default(uuid())
  blockerId String
  blockedId String
  blocker User @relation(name: "Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation(name: "BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
