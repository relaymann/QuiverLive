datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

model User {
  id             String  @id @default(uuid())
  username       String  @unique
  imageUrl       String  @db.Text
  externalUserId String  @unique
  bio            String? @db.Text
  following  Follow[] @relation("Following")
  followedBy Follow[] @relation("FollowedBy")
  blocking   Block[]  @relation("Blocking")
  blockedBy  Block[]  @relation("BlockedBy")
  stream         Stream?
  chatRateLimits ChatRateLimit[]
  moderatedInChannels ChatModeration[] @relation("ModeratedParticipant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stream {
  id           String  @id @default(uuid())
  name         String  @db.Text
  thumbnailUrl String? @db.Text
  ingressId    String? @unique
  serverUrl    String? @db.Text
  streamKey    String? @db.Text
  isLive              Boolean @default(false)
  isChatEnabled       Boolean @default(true)
  isChatDelayed       Boolean @default(false)
  isChatFollowersOnly Boolean @default(false)
  broadcastSource     String? @db.VarChar(16)
  broadcastSessionId String? @db.VarChar(64)
  broadcastLeaseExpiresAt DateTime?
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRateLimits ChatRateLimit[]
  guestChatRateLimits GuestChatRateLimit[]
  chatModerations ChatModeration[]
  watchSessions WatchSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([ingressId])
  @@index([broadcastSessionId])
  @@index([isLive, updatedAt])
  @@fulltext([name])
}

model ChatRateLimit {
  id            String   @id @default(uuid())
  streamId      String
  senderId      String
  nextAllowedAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@unique([streamId, senderId])
  @@index([nextAllowedAt])
}

model GuestChatRateLimit {
  id            String   @id @default(uuid())
  streamId      String
  senderIdentity String @db.VarChar(128)
  nextAllowedAt DateTime @default(now())
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([streamId, senderIdentity])
  @@index([nextAllowedAt])
}

model ChatModeration {
  id                  String   @id @default(uuid())
  streamId            String
  participantIdentity String   @db.VarChar(128)
  participantUserId   String?
  isBanned            Boolean  @default(false)
  timedOutUntil       DateTime?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  participantUser User? @relation("ModeratedParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([streamId, participantIdentity])
  @@index([streamId, isBanned])
  @@index([timedOutUntil])
}

model WatchSession {
  id                  String   @id @default(uuid())
  streamId            String
  broadcastSessionId  String   @db.VarChar(64)
  participantSid      String   @db.VarChar(128)
  participantIdentity String   @db.VarChar(128)
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@unique([streamId, broadcastSessionId, participantSid])
  @@index([streamId, participantIdentity, endedAt])
  @@index([streamId, broadcastSessionId, endedAt])
  @@index([streamId, participantSid, endedAt])
  @@index([startedAt])
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String
  follower  User @relation(name: "Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation(name: "FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String @id @default(uuid())
  blockerId String
  blockedId String
  blocker User @relation(name: "Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation(name: "BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// Metadata for VODs and clips; media bytes are stored by an external object-storage provider.
model VideoAsset {
  id String @id @default(uuid())
  streamId String
  ownerUserId String
  kind String @db.VarChar(16)
  title String @db.VarChar(120)
  description String? @db.Text
  storageKey String @db.Text
  playbackUrl String? @db.Text
  thumbnailUrl String? @db.Text
  mimeType String? @db.VarChar(128)
  sizeBytes BigInt?
  durationSeconds Int?
  visibility String @default("private") @db.VarChar(16)
  processingState String @default("queued") @db.VarChar(20)
  sourceStartedAt DateTime?
  sourceEndedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerUserId, createdAt])
  @@index([streamId, kind, createdAt])
  @@index([processingState, createdAt])
}

model Clip {
  id String @id @default(uuid())
  videoAssetId String
  streamId String
  ownerUserId String
  title String @db.VarChar(120)
  startSeconds Int
  endSeconds Int
  status String @default("queued") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([videoAssetId, startSeconds])
  @@index([streamId, createdAt])
  @@index([ownerUserId, createdAt])
}

model ChannelPointBalance {
  id String @id @default(uuid())
  streamId String
  userId String
  balance BigInt @default(0)
  updatedAt DateTime @updatedAt
  @@unique([streamId, userId])
  @@index([userId, updatedAt])
}

model ChannelPointTransaction {
  id String @id @default(uuid())
  streamId String
  userId String
  amount BigInt
  reason String @db.VarChar(32)
  referenceId String? @db.VarChar(191)
  idempotencyKey String @db.VarChar(191)
  metadata Json?
  createdAt DateTime @default(now())
  @@unique([streamId, idempotencyKey])
  @@index([streamId, userId, createdAt])
}

model ChannelReward {
  id String @id @default(uuid())
  streamId String
  title String @db.VarChar(80)
  description String? @db.VarChar(500)
  cost Int
  isEnabled Boolean @default(true)
  cooldownSeconds Int @default(0)
  maxPerUser Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([streamId, isEnabled])
}

model ChannelRole {
  id String @id @default(uuid())
  streamId String
  userId String
  role String @db.VarChar(24)
  grantedBy String
  createdAt DateTime @default(now())
  @@unique([streamId, userId, role])
  @@index([streamId, role])
}

model ChatCommand {
  id String @id @default(uuid())
  streamId String
  name String @db.VarChar(32)
  response String @db.VarChar(500)
  enabled Boolean @default(true)
  cooldownSeconds Int @default(0)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([streamId, name])
  @@index([streamId, enabled])
}

model ChannelEmote {
  id String @id @default(uuid())
  streamId String
  name String @db.VarChar(32)
  imageUrl String @db.Text
  isEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([streamId, name])
  @@index([streamId, isEnabled])
}

model Notification {
  id String @id @default(uuid())
  userId String
  type String @db.VarChar(32)
  title String @db.VarChar(120)
  body String? @db.VarChar(500)
  targetUrl String? @db.Text
  actorId String?
  dedupeKey String? @db.VarChar(191)
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
  @@unique([userId, dedupeKey])
}

model Raid {
  id String @id @default(uuid())
  sourceStreamId String
  targetStreamId String
  initiatedBy String
  participantCount Int @default(0)
  status String @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([targetStreamId, createdAt])
  @@index([sourceStreamId, createdAt])
}

model Subscription {
  id String @id @default(uuid())
  streamId String
  subscriberUserId String
  provider String @db.VarChar(24)
  providerCustomerId String? @db.VarChar(191)
  providerSubscriptionId String? @unique @db.VarChar(191)
  status String @db.VarChar(24)
  tier String @default("standard") @db.VarChar(32)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([streamId, status, createdAt])
  @@index([subscriberUserId, status])
}

model StreamAnalyticsDaily {
  id String @id @default(uuid())
  streamId String
  day DateTime @db.Date
  totalLiveSeconds BigInt @default(0)
  uniqueViewers Int @default(0)
  peakViewers Int @default(0)
  totalViewerSeconds BigInt @default(0)
  chatMessages Int @default(0)
  follows Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([streamId, day])
  @@index([streamId, day])
}

model RecentlyWatched {
  id String @id @default(uuid())
  userId String
  streamId String
  watchedAt DateTime @default(now())
  @@unique([userId, streamId])
  @@index([userId, watchedAt])
}
